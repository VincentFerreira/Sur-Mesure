{
  "name": "latex-cv-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --watch server.js",
    "start": "concurrently -n vite,latex -c cyan,yellow \"npm run dev\" \"npm run server\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^1.40.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^1.16.0",
    "mustache": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^10.0.5",
    "jsdom": "^27.0.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "supertest": "^7.2.2",
    "typescript": "~7.0.2",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  }
}
