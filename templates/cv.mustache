\documentclass[11pt, a4paper]{article}

% Packages
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
[[ fontPackage ]]
\usepackage{geometry}
\usepackage{fontawesome5}
\usepackage{xcolor}
\usepackage{hyperref}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{graphicx}
\usepackage{tabularx}
\newcommand{\needspace}[1]{\vskip#1\relax\penalty9999\relax\vskip-#1\relax}

% Colors
\definecolor{darkblue}{RGB}{50, 60, 110}
\definecolor{graytext}{RGB}{80, 80, 80}
\definecolor{lightgray}{RGB}{200, 200, 200}
\definecolor{accent}{RGB}{59, 130, 246}

% Page Layout
\geometry{left=1.5cm, right=1.5cm, top=1.5cm, bottom=1.5cm}
\pagestyle{empty}
\linespread{1.15}

% Éviter les veuves et orphelines
\widowpenalty=10000
\clubpenalty=10000
\brokenpenalty=10000

% Commands
\newcommand{\cvsection}[1]{
  \needspace{2.5cm}
  \nopagebreak[4]
  \vspace{0.6cm}
  {\color{darkblue}\Large\bfseries\uppercase{#1}} \\[-0.2cm]
  {\color{darkblue}\rule{\linewidth}{1pt}}
  \vspace{0.35cm}
  \nopagebreak[4]
}

% Header layout
\newlength{\headerphotomaxwidth}\setlength{\headerphotomaxwidth}{4.0cm}
\newlength{\headertextwidth}
\newlength{\headercolgap}\setlength{\headercolgap}{0.6cm}
\newlength{\headerrulegap}\setlength{\headerrulegap}{0.3cm}
\newsavebox{\headerbody}
\newsavebox{\headerphoto}
\newsavebox{\projectsbox}
\newlength{\headergap}\setlength{\headergap}{0.5cm}
% Fixed-width, centred icon box: keeps contact labels aligned regardless of icon width.
\newcommand{\contacticon}[1]{\makebox[1.35em][c]{\color{accent}#1}\hspace{0.25em}}
\hypersetup{hidelinks}

\newcommand{\cvtag}[1]{
  \tikz[baseline]\node[anchor=base,draw=lightgray,rounded corners,inner xsep=1ex,inner ysep =0.75ex,text height=1.5ex,text depth=.25ex]{\small #1};
}

\begin{document}

% HEADER
% The text block is typeset first into a box so its height can be measured;
% the photo is then scaled to exactly that height (capped at
% \headerphotomaxwidth wide) and both are centred on the same axis. The gap
% between photo and text stays constant whatever the photo's aspect ratio.
[[# hasPhoto ]]
\setlength{\headertextwidth}{\dimexpr\linewidth-\headerphotomaxwidth-\headergap\relax}
[[/ hasPhoto ]]
[[^ hasPhoto ]]
\setlength{\headertextwidth}{\linewidth}
[[/ hasPhoto ]]
\begin{lrbox}{\headerbody}\begin{minipage}[c]{\headertextwidth}
  \raggedright
  % Semibold (sb) for the whole name; fonts without it fall back to bold.
  {\fontsize{26}{28}\fontseries{sb}\selectfont\color{darkblue}[[ firstName ]] \MakeUppercase{[[ lastName ]]}\par}
  \vspace{0.18cm}
  {\large\color{accent}[[ title ]]\par}
[[# availability ]]
  \vspace{0.2cm}
  {\setlength{\fboxsep}{2.5pt}\colorbox{accent!10}{\footnotesize\bfseries\color{darkblue}\,\faCalendarCheck[regular]\;[[ availability ]]\,}\par}
[[/ availability ]]
  % Rule spacing is explicit (no baselineskip) so the gaps above and below it
  % are equal and independent of the font size of the lines around it.
  \par\nointerlineskip\vspace{\headerrulegap}
  {\color{lightgray}\rule{\linewidth}{0.4pt}\par}
  \nointerlineskip\vspace{\headerrulegap}
  {\small\color{graytext}\renewcommand{\arraystretch}{1.25}%
  % Natural-width columns: labels never wrap; the right column starts a fixed gap
  % after the widest left label, so both columns stay aligned.
  \begin{tabular}{@{}l@{\hspace{\headercolgap}}l@{}}
[[# contactRows ]]
  [[# left ]]\contacticon{\[[ icon ]]}[[# url ]]\href{[[ url ]]}{[[ text ]]}[[/ url ]][[^ url ]][[ text ]][[/ url ]][[/ left ]] &
  [[# right ]]\contacticon{\[[ icon ]]}[[# url ]]\href{[[ url ]]}{[[ text ]]}[[/ url ]][[^ url ]][[ text ]][[/ url ]][[/ right ]] \\
[[/ contactRows ]]
  % Empirical: drop the extra strut depth \arraystretch adds under the last
  % row so the photo's bottom edge lines up with the last contact line's descenders.
  \noalign{\vspace{-4.3pt}}
  \end{tabular}\par}
\end{minipage}\end{lrbox}%
\noindent
[[# hasPhoto ]]
\sbox{\headerphoto}{\includegraphics[width=\headerphotomaxwidth, height=\dimexpr\ht\headerbody+\dp\headerbody\relax, keepaspectratio]{photo.[[ photoExtension ]]}}%
\begin{minipage}[c]{\wd\headerphoto}\usebox{\headerphoto}\end{minipage}%
\hspace{\headergap}%
[[/ hasPhoto ]]
\usebox{\headerbody}

\vspace{0.6cm}
\noindent
\small\color{graytext}
[[ summary ]]

% SKILLS
\cvsection{[[ tSkills ]]}
\vspace{0.15cm}
\begin{tabularx}{\linewidth}{@{}l X@{}}
  \noalign{\vspace{0.2cm}}
[[# skills ]]
\textbf{[[ name ]]} & [[ items ]] \\[0.25cm]
[[/ skills ]]
\end{tabularx}

% EXPERIENCE
\cvsection{[[ tExperience ]]}
\vspace{0.15cm}
[[# experience ]]

\needspace{3.5cm}
\noindent
\begin{tabularx}{\linewidth}{@{}p{2.4cm} X@{}}
\textbf{[[ startDate ]]} & \textbf{[[ role ]]} \\
\emph{[[ endDate ]]} & \emph{[[ company ]] -- [[ location ]]}
\end{tabularx}%
\nopagebreak[4]%
\begin{itemize}[leftmargin=2.82cm, noitemsep, topsep=2pt, parsep=0pt, itemsep=1pt]
[[# description ]]
    \item [[.]]
[[/ description ]]
\end{itemize}%
\nopagebreak[4]%
\noindent\hspace{2.82cm}\begin{minipage}[t]{\dimexpr\linewidth-2.82cm\relax}{\footnotesize \color{graytext} \textit{[[ tTech ]]} [[ techStack ]]}\end{minipage}
[[# hasSpacing ]]
\vspace{0.3cm}
[[/ hasSpacing ]]
[[/ experience ]]
[[# hasProjects ]]
% PERSONAL PROJECTS
% The table is typeset into a box first so its real height is known: reserving
% that much (plus the heading) moves heading + projects to the next page
% together. \cvsection's own \needspace{2.5cm} is not enough for 2+ projects
% and left the heading orphaned at the bottom of the page.
\begin{lrbox}{\projectsbox}\begin{tabularx}{\linewidth}{@{}X@{}}
  \noalign{\vspace{0.2cm}}
[[# projects ]]
% Optional link, right-aligned on the title line (same icon style as the header).
\textbf{[[ name ]]}[[# url ]]\hfill{\small\href{[[ url ]]}{\contacticon{\faLink}[[ urlText ]]}}[[/ url ]] \\
% Tech stack shares the description's cell: as its own row it would get a
% full-size strut and sit visibly detached from the description.
[[ description ]][[# techStack ]]\par{\footnotesize\color{graytext}\textit{[[ techStack ]]}}[[/ techStack ]] \\
\noalign{\vspace{0.25cm}}
[[/ projects ]]
\end{tabularx}\end{lrbox}
\needspace{\dimexpr\ht\projectsbox+\dp\projectsbox+2.5cm\relax}
\cvsection{[[ tProjects ]]}
% Same structure as EDUCATION: the table sits in the heading's paragraph, so it
% gets the same gap under the rule. Don't add \needspace / \par between the
% heading and the table: ending the heading's paragraph early opens a ~1cm gap.
\vspace{0.15cm}
\usebox{\projectsbox}
[[/ hasProjects ]]
% EDUCATION (certifications, then degrees)
\cvsection{[[ tEducation ]]}
\vspace{0.15cm}
\begin{tabularx}{\linewidth}{@{}p{2.4cm} X@{}}
  \noalign{\vspace{0.2cm}}
[[# certifications ]]
\textbf{[[ year ]]} & \textbf{[[ title ]]} -- [[ issuer ]] \\[0.2cm]
[[/ certifications ]]
[[# education ]]

\textbf{[[ year ]]} & \textbf{[[ degree ]]} \\
& [[ school ]], [[ location ]] \\
& {\small [[ description ]]} \\[0.2cm]
[[/ education ]]
\end{tabularx}
\vspace{-0.5cm}
% LANGUAGES
\cvsection{[[ tLanguages ]]}
\vspace{-0.9cm}
\begin{itemize}[leftmargin=*, noitemsep, topsep=2pt, parsep=0pt, itemsep=1pt]
[[# languages ]]
  \item [[.]]
[[/ languages ]]
\end{itemize}
