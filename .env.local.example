GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override pdflatex path (default: /Library/TeX/texbin/pdflatex for macOS)
# Linux example: PDFLATEX_PATH=/usr/bin/pdflatex
# Windows example: PDFLATEX_PATH=C:\texlive\2024\bin\windows\pdflatex.exe
# PDFLATEX_PATH=/Library/TeX/texbin/pdflatex

# Required for the job-search scraping feature (server-side only — these are NOT
# injected into the client bundle by vite.config.ts, unlike GEMINI_API_KEY/
# ANTHROPIC_API_KEY above). Register an app at https://francetravail.io to obtain them
# (subscribe to the "Offres d'emploi v2" API). Set as real shell/process env vars, same
# as PDFLATEX_PATH — this file is only a reference, not auto-loaded.
# FRANCE_TRAVAIL_CLIENT_ID=your_client_id_here
# FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret_here

# Optional: path to the `claude` CLI binary, used by the entire job-search AI
# pipeline (server/scrapers/claudeCli.js) — the claude_cli search portal (Claude
# Code's own WebSearch/WebFetch) as well as keyword expansion and candidate
# qualification, none of which call a separate billed Anthropic/Gemini API. Only
# needed when `claude` isn't on PATH for the server process — e.g. inside the Docker
# container, where docker-compose.yml sets this to the bind-mounted host binary's
# path. Outside Docker, if `claude` is on your PATH, you don't need this at all.
# CLAUDE_CLI_PATH=/usr/local/bin/claude
